# Port exposed on the host for the Themis web UI and API.
# The internal container port is always 8000; only the host side is configurable.
HOST_PORT=8001

# OrcaSlicer version to install at container start.
# The AppImage is downloaded once and cached in the laminus-slicer named volume.
# Update this value and restart to switch versions without rebuilding the image.
# Must match the default in docker-compose.yml and laminus/Dockerfile — CI derives
# the AppImage cache key from this value, so a mismatch silently busts the cache.
ORCA_VERSION=2.4.2

# Host port for the Laminus web UI and API (container port is always 5000).
LAMINUS_PORT=5000

# Host port for the Ordinus web UI and API.
# 3002 matches docker-compose.test.yml and the ORDINUS_URL default in
# tests/e2e/helpers.py. Changing it here without changing those points the
# e2e suite at a port nothing is listening on.
ORDINUS_PORT=3002

# Break-glass full-scope key for local dev and e2e test seeding (Themis auth).
# Fixed dev-only value, not a real secret. Without it the e2e suite has no
# credential (Themis has no open bootstrap window).
THEMIS_BOOTSTRAP_KEY=dev-e2e-bootstrap-key

# CORS allowed origin for the Ordinus API.
# Default '*' allows access from any machine on the LAN — suitable for a trusted home workshop.
# To restrict to a specific host: CORS_ORIGIN=http://192.168.1.50:3001
CORS_ORIGIN=*

# Optional: publish Themis on one host address only (default: all interfaces), e.g. your Tailscale IP.
# THEMIS_BIND_IP=100.x.y.z
# CIDRs whose clients are Themis admin without signing in (default 192.168.0.0/16). Docker NATs
# published-port traffic, so behind Docker Desktop every client looks like the bridge gateway
# (check `docker network inspect concordia_default`, usually 172.18.0.1). To treat a Tailscale-only
# bind as local, add that gateway as a /32 -- and ONLY together with THEMIS_BIND_IP, or every
# device that can reach the port becomes admin.
# THEMIS_LOCAL_NETWORKS=192.168.0.0/16,172.18.0.1/32
